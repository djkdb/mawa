# ---------------------------------------------------------------------------
# My AI Work Agent — environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Agent mode: "demo" runs the full pipeline on fixtures with no credentials.
AGENT_MODE=demo

# LLM provider: anthropic | openai | openai-compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
# Only for openai-compatible (e.g. Ollama, vLLM)
LLM_BASE_URL=

# GitHub (Real Mode). Either an OAuth App or a GitHub App's OAuth credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth App: scopes requested (default "read:user repo" — note `repo` is read/write; GitHub has no
# read-only repo scope for OAuth Apps). GitHub App: set to "" so permissions come from the app
# (recommended: Contents, Issues, Pull requests, Metadata = Read-only).
# GITHUB_OAUTH_SCOPES=read:user repo

# Google OAuth Client (Gmail + Calendar, read-only scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API server
API_PORT=3001
# Interface to bind. Loopback by default: run records contain mail and calendar data.
API_HOST=127.0.0.1
# Optional shared secret (>=16 chars). When set, the web UI asks for it once.
# API_ACCESS_TOKEN=
WEB_ORIGIN=http://localhost:5173
# 32-byte hex key used to encrypt OAuth tokens at rest
SESSION_ENCRYPTION_KEY=

# Public URL of the API as seen by OAuth providers (redirect URIs are
# <API_PUBLIC_URL>/auth/github/callback and /auth/google/callback)
API_PUBLIC_URL=http://localhost:3001
# Where encrypted OAuth tokens are stored (default: .tokens/tokens.enc.json)
TOKEN_STORE_PATH=

# ---------------------------------------------------------------------------
# Static apps (build-time, Vite). Not secrets.
# ---------------------------------------------------------------------------
# apps/web
# VITE_API_URL=              # absolute API origin when web and API are on different hosts
# VITE_PUBLIC_URL=           # public URL of the deployed web demo (absolute og:image / og:url)
# VITE_DEMO_MODE=true        # browser-only replay build (or: vite build --mode demo)
# portfolio
# VITE_PORTFOLIO_URL=        # QR code target
# VITE_LIVE_APP_URL=         # "Live demo" CTA → deployed web demo
# VITE_CONTACT_EMAIL=        # shows the Email button when set

# CBNU eCampus (Moodle). No app registration: connect in the UI with your 개신누리 id/password,
# which the API exchanges once for a mobile web-service token (password not stored).
# LMS_BASE_URL=https://lms.chungbuk.ac.kr
