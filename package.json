{
  "name": "my-ai-work-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Connect work. Understand context. Execute with AI. A personal work agent built on MCP.",
  "license": "MIT",
  "author": "Lee Seongjun",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "mcp-servers/*",
    "apps/*",
    "portfolio",
    "motion"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "clean": "rimraf --glob \"**/dist\" \"**/*.tsbuildinfo\" --no-glob-ignore node_modules",
    "pretest": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
