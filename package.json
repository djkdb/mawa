{
  "name": "my-ai-work-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Connect work. Understand context. Execute with AI. A personal work agent built on MCP.",
  "license": "MIT",
  "author": "Lee Seongjun",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "mcp-servers/*",
    "apps/*",
    "portfolio",
    "motion"
  ],
  "scripts": {
    "dev": "tsc -b && concurrently -k -n api,web,portfolio -c blue,green,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w portfolio --if-present\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b && npm run typecheck -w apps/web -w portfolio",
    "clean": "rimraf --glob \"**/dist\" \"**/*.tsbuildinfo\" --no-glob-ignore node_modules",
    "pretest": "tsc -b",
    "export:portfolio-data": "node scripts/export-portfolio-data.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@mawa/agent-core": "*"
  }
}
